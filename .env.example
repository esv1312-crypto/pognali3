# Copy into your local environment; never commit real secrets.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Required for production Telegram Mini App authentication (BotFather token).
TELEGRAM_BOT_TOKEN=
# Optional: set false for local PostgreSQL without TLS. Render internal DB URL may not require TLS.
DATABASE_SSL=disable
PORT=3000
WEB_ROOT=docs/telegram
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret
MINI_APP_URL=https://pognali-telegram-mini-app.onrender.com

# Comma-separated Telegram numeric user IDs allowed to use Mini App moderation.
# Set this explicitly in Render; do not rely on the legacy source-code fallback.
ADMIN_TELEGRAM_IDS=123456789,987654321
# Additional token required by legacy /api/admin/reports endpoints.
# Generate a unique random secret; never reuse the Telegram bot token.
ADMIN_API_TOKEN=replace-with-a-long-random-secret
# Optional Telegram user/group chat ID for new event-report notifications.
ADMIN_TELEGRAM_CHAT_ID=
