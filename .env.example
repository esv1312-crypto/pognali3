# Copy into your local environment; never commit real secrets.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Required for production Telegram Mini App authentication (BotFather token).
TELEGRAM_BOT_TOKEN=
# Optional: set false for local PostgreSQL without TLS. Render internal DB URL may not require TLS.
DATABASE_SSL=disable
PORT=3000
WEB_ROOT=docs/telegram
